# Places Tracker production environment variables
# Copy this file to .env.prod and fill in your values
#
# Usage: cp .env.prod.example .env.prod
#
# deploy-to-exe.sh copies this to .env on the VM with 600 perms.

# MongoDB database name (single-container, no auth - bound to 127.0.0.1 on VM)
MONGO_INITDB_DATABASE=placestracker

# Google Maps API Key (required for place lookup / autofill features)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Java memory settings (adjust for VM resources)
JAVA_OPTS=-Xms256m -Xmx512m
